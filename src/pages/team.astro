---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Team · Space Array" active="team.html">

<main>

  <section class="hero">
    <div class="kicker">People</div>
    <h1>Team and contributors</h1>
    <p class="lead">
      This page lists core organisers, science leads, technology leads,
      institutional contributors, and early-career researchers involved
      in the initiative.
    </p>
  </section>

  <section class="card" id="team-list">
    <p>Loading team members...</p>
  </section>

<section class="section">
  <h2>Support and Contributions</h2>

  <p class="lead">
    The Space Array Initiative benefits from financial support,
    in-kind contributions, facilities, computing resources,
    and expert effort from organizations and individuals.
  </p>

  <div class="card">
    <div class="kicker">2025-2026</div>
    <h3>CNES</h3>
    <p>
      Support for Space Array science-roadmap activities.
    </p>
  </div>

  <!-- <div class="card">
    <div class="kicker">2025–2026</div>
    <h3>Contributor / Organization</h3>
    <p>
      Support for SHARP mission-concept development and proposal preparation.
    </p>
  </div> -->

  <!-- <div class="card">
    <div class="kicker">2026–2027</div>
    <h3>Contributor / Organization</h3>
    <p>
      In-kind support for workshops, simulations, technical studies,
      community coordination, or engineering activities.
    </p>
  </div> -->

</section>

</main>

<script is:inline slot="after-footer">
fetch("team.json")
  .then(response => {
    if (!response.ok) {
      throw new Error("Could not load team.json");
    }
    return response.json();
  })
  .then(members => {
    const container = document.getElementById("team-list");
    container.innerHTML = "";

    members.forEach(member => {
      const div = document.createElement("div");
      div.className = "person";

      const role = member.role ? member.role.trim() : "";
      const affiliation = member.affiliation ? member.affiliation.trim() : "";
      const interests = member.interests ? member.interests.trim() : "";

      let roleLine = "";

      if (role && affiliation) {
        roleLine = `<p class="role">${role} · ${affiliation}</p>`;
      } else if (role) {
        roleLine = `<p class="role">${role}</p>`;
      } else if (affiliation) {
        roleLine = `<p class="role">${affiliation}</p>`;
      }

      div.innerHTML = `
        <h3>${member.name}</h3>
        ${roleLine}
        <p>${interests}</p>
      `;

      container.appendChild(div);
    });
  })
  .catch(error => {
    const container = document.getElementById("team-list");
    container.innerHTML = "<p>Unable to load team information.</p>";
    console.error(error);
  });
</script>

</Layout>
